# syntax=docker/dockerfile:1

FROM python:3.10.13-slim-bookworm

ARG DEBIAN_FRONTEND=noninteractive
ARG XFEAT_COMMIT=e92685f57f8318b18725c5c8c0bd28c7fe188d9a

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MPLBACKEND=Agg \
    PYTHONPATH=/workspace/src:/workspace/third_party/accelerated_features \
    TORCH_HOME=/opt/torch-cache

WORKDIR /workspace

# System/runtime dependencies.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        ffmpeg \
        libgl1 \
        libglib2.0-0 \
        libgomp1 && \
    rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# Python environment
# ------------------------------------------------------------

COPY requirements.txt /tmp/requirements.txt

# Install the exact CPU-only PyTorch pair explicitly.
RUN python -m pip install --upgrade pip && \
    python -m pip install \
        torch==2.2.2 \
        torchvision==0.17.2 \
        --index-url https://download.pytorch.org/whl/cpu && \
    grep -vE '^(torch|torchvision)==' \
        /tmp/requirements.txt \
        > /tmp/requirements-nontorch.txt && \
    python -m pip install \
        --no-cache-dir \
        -r /tmp/requirements-nontorch.txt

# ------------------------------------------------------------
# Pinned XFeat source
# ------------------------------------------------------------

RUN mkdir -p /workspace/third_party && \
    git clone \
        https://github.com/verlab/accelerated_features.git \
        /workspace/third_party/accelerated_features && \
    git -C /workspace/third_party/accelerated_features \
        checkout --detach "${XFEAT_COMMIT}"

# ------------------------------------------------------------
# Project source
# ------------------------------------------------------------

COPY src/ /workspace/src/
COPY scripts/ /workspace/scripts/
COPY configs/ /workspace/configs/

# ------------------------------------------------------------
# Stage-2 build smoke test
# ------------------------------------------------------------

RUN python - <<'PY'
import sys
import cv2
import numpy
import pandas
import scipy
import torch
import torchvision
import yaml
import pyproj
import rasterio
import sklearn
import folium

from modules.xfeat import XFeat

print("Python:", sys.version)
print("Torch:", torch.__version__)
print("Torchvision:", torchvision.__version__)
print("CUDA available:", torch.cuda.is_available())
print("OpenCV:", cv2.__version__)
print("Rasterio:", rasterio.__version__)
print("PyProj:", pyproj.__version__)
print("XFeat import: PASS")
print("STAGE2_BUILD_IMPORT_SMOKE: PASS")
PY

CMD ["bash"]
